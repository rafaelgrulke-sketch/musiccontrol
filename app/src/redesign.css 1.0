/* MusicControl — Impeccable / editorial listening room */
:root{font-family:'DM Sans',Inter,ui-sans-serif,system-ui,sans-serif;color:#f1f0ec;background:#101311;font-synthesis:none}body{background:#101311;color:#f1f0ec}::selection{background:#b9d9aa;color:#101311}button:focus-visible,input:focus-visible{outline:2px solid #c2e2b4;outline-offset:3px}button{transition:background-color .18s ease,color .18s ease,border-color .18s ease,transform .18s ease}button:active{transform:scale(.98)}.shell{background:#101311}.sidebar{width:252px;background:#141815;border-right:1px solid #2a302b;padding:34px 20px 25px}.brand{font-size:22px;font-weight:750;letter-spacing:-.9px;margin-bottom:64px}.brand-icon{background:#c7e5b7;color:#172117;border-radius:11px}.brand-accent{color:#c7e5b7}.nav-label{letter-spacing:1.15px;color:#89988b;font-size:10px}.navigation{gap:5px}.navigation button{border-radius:9px;color:#9fa9a0;font-weight:550;padding:13px 15px}.navigation button:hover{background:#222b23;color:#f3f7f0}.navigation .nav-active{background:#283a2c;color:#d5efcb}.sidebar-bottom{color:#87968a}.content{margin-left:252px;max-width:1650px;padding:33px clamp(24px,4vw,68px) 160px}.topbar{margin-bottom:35px}.avatar{background:#29392b;color:#d5ebc9}.hero{min-height:305px;border:0;background:#243328;border-radius:14px;padding:clamp(26px,4vw,56px);position:relative}.hero:after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(105deg,transparent 55%,rgba(186,218,169,.07));border-radius:inherit}.hero h1{font-size:clamp(37px,4.2vw,64px);line-height:1.06;letter-spacing:-.035em;max-width:680px}.hero h1 em{color:#c4e2b5}.hero p{color:#c0cfc0}.hero-art{color:#bcd9ac;opacity:.38}.eyebrow{color:#b7d0ad;letter-spacing:1.3px;font-size:10px}.primary{background:#c8e8b9;color:#142017;border-radius:8px;font-weight:700}.primary:hover{background:#e0f5d6}.secondary{background:#2a352c;color:#e1eee0;border-radius:8px}.secondary:hover{background:#354737}.stats{gap:0;margin:34px 0 45px;border-top:1px solid #303a31;border-bottom:1px solid #303a31}.stat{background:transparent;border:0;border-right:1px solid #303a31;border-radius:0;padding:22px 26px}.stat:first-child{padding-left:0}.stat:last-child{border:0}.stat svg{color:#b2d6a4}.stat strong{font-size:29px;letter-spacing:-.04em}.stat span,.muted{color:#9eaea1}.section-head{margin:34px 0 18px}.section-head h2{font-size:23px;letter-spacing:-.025em}.text-button{color:#c5e5b7}.empty{background:#171e19;border:1px dashed #435246;border-radius:12px;color:#a8c99d}.empty h3{color:#f0f4ee}.empty p{color:#a6b3a7}.page-head h1{font-size:clamp(32px,4vw,48px);letter-spacing:-.04em}.page-head p{color:#aab7aa}.library-toolbar{color:#a0afa2}.search{background:#1b241e;border:1px solid #39463b;border-radius:9px;color:#a2b4a3}.search input{color:#f5f7f2}.tracks{background:transparent;border:0;border-radius:0}.track{padding:12px 10px;border-bottom:1px solid #2a352c;gap:16px}.track:hover,.active-track{background:#1c2a20}.track-index{color:#92a195}.track-cover{background:#354b39;color:#d4e9ce;border-radius:6px}.track-title{color:#f2f5ef}.track-title small{color:#9baa9c}.icon-btn{color:#9aab9d}.icon-btn:hover,.toggled{color:#d2efc4}.playlist-grid{gap:22px}.playlist-card{background:transparent;border:1px solid transparent;border-radius:9px;padding:10px;color:#f1f5ed}.playlist-card:hover,.playlist-selected{background:#1b251d;border-color:#435747}.playlist-art{height:160px;background:#344837;border-radius:7px;color:#cde6c3}.playlist-card small{color:#a2afa4}.artist-grid{gap:20px}.artist-card{background:transparent;border:1px solid transparent;border-radius:9px}.artist-card:hover{background:#1c261e;border-color:#3e5141}.artist-avatar{background:#344b38;color:#d3eacb}.artist-card small,.artist-heading-text span{color:#a5b2a5}.artist-section{background:#171e19;border:1px solid #2d3a30;border-radius:12px}.player{height:92px;background:#19221b;border-top:1px solid #39483b;padding:10px 30px}.now-cover{border-radius:6px;background:#3b513d;color:#d8ecd1}.now-text small,.seek{color:#a8b8a8}.play-main{background:#c9e8bb;color:#152118}.volume{color:#a7b8a8}input[type=range]{accent-color:#c4e4b5}.mc-overlay{background:rgba(5,11,7,.83)}.mc-modal{background:#1c251e;border:1px solid #405044;border-radius:14px;color:#f1f6ef}.mc-modal-symbol{background:#304734;color:#d2e9ca}.mc-modal-copy{color:#aab9aa}.mc-field{color:#dbe9d9}.mc-field input{background:#121b14;border:1px solid #455747;border-radius:8px;color:#fff}.mc-field input:focus{border-color:#c4e4b5;box-shadow:0 0 0 3px rgba(196,228,181,.13)}.mc-playlist-choice{background:#18221a;border-color:#394a3d;color:#e6f0e4;border-radius:8px}.mc-playlist-choice:hover{background:#27392b;border-color:#b7d8aa}.mc-playlist-choice-icon{background:#314934;color:#d3ebcb}.mc-new-playlist{background:#253628;border-color:#789b7a;color:#d6edcd}.mc-cover-editor{background:#151e17;border-color:#3b4c3e}.mc-edit-cover{background:#334b38;color:#d8eed0}.mc-toast{background:#29392c;border-color:#56735b;color:#edf6e9}.mc-toast svg{color:#c5e5b8}.mc-toast-error{background:#442a2d;border-color:#985c64}.mc-danger-button{background:#5b3035;border-color:#8c5057}.mc-danger-button:hover{background:#703a41}*{scrollbar-color:#465e49 #151d17}input::placeholder{color:#839685}@media(max-width:850px){.sidebar{width:72px}.content{margin-left:72px;padding:25px 25px 150px}}@media(max-width:600px){.sidebar{width:100%;height:63px;top:auto;bottom:0;padding:5px 10px;background:#19221b}.content{margin:0;padding:18px 17px 220px}.hero{min-height:260px;padding:26px}.hero h1{font-size:36px}.stats{margin:24px 0 32px}.stat{padding:15px 10px}.stat:first-child{padding-left:0}.stat strong{font-size:22px}.player{bottom:63px;height:138px;padding:10px 15px}.playlist-art{height:130px}}
